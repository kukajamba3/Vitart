# ── База данных ──
# Вариант 1 (локально / свой сервер): свой Postgres, напр. из docker-compose.yml
DATABASE_URL="postgresql://anime:anime@localhost:5432/animehub?schema=public"
# Вариант 2 (деплой на Layero): создайте базу PostgreSQL в панели Layero и подключите
# её к проекту — строка подключения сама приедет в переменной LAYERO_DATABASE_URL
# (приложение подхватит её автоматически, см. src/lib/prisma.ts).
# Вариант 3 (бесплатно, без Pro): внешний Postgres, напр. Supabase — строку подключения
# вставьте в панели Layero в переменную DATABASE_URL (Project → Environment Variables),
# добавьте ?sslmode=require в конец строки.
# На стадии сборки Layero все env доступны, поэтому миграции применятся автоматически
# (скрипт db:migrate:safe), а при первом старте таблицы создадутся сами (IF NOT EXISTS).

POSTGRES_USER=anime
POSTGRES_PASSWORD=anime
POSTGRES_DB=animehub

# ── Resend (подтверждение почты) ──
# Ключ создаётся в кабинете resend.com → API Keys (начинается с re_...)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# От кого письма. До верификации домена в Resend можно отправлять ТОЛЬКО с onboarding@resend.dev
# и ТОЛЬКО на email, с которого вы зарегистрировались в Resend.
EMAIL_FROM="АнимеХаб <noreply@your-domain.ru>"

# ── Сайт ──
SITE_URL="http://localhost:3000"   # в проде: https://<project>.layero.app или ваш домен
SITE_NAME="АнимеХаб"

# ── Источники данных (публичные API, ключи не нужны) ──
ANILIBRIA_API_BASE="https://api.anilibria.tv/v2.1"
ANILIBRIA_SITE="https://anilibria.tv"
# Если api.animevost.org недоступен — укажите актуальное зеркало API
ANIVOST_API_BASE="https://api.animevost.org/v1"
