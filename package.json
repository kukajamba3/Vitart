{
  "name": "animehub",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/copy-standalone.cjs",
    "start": "next start -H 0.0.0.0",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:safe": "sh -c 'if [ -n \"$DATABASE_URL$LAYERO_DATABASE_URL\" ]; then DATABASE_URL=\"${DATABASE_URL:-$LAYERO_DATABASE_URL}\" npx prisma migrate deploy; else echo \"[db] DATABASE_URL/LAYERO_DATABASE_URL не заданы — миграция пропущена, таблицы создадутся при первом старте приложения\"; fi'",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "hls.js": "^1.5.17",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
